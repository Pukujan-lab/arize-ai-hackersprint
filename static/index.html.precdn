<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Precedent — Legal research workspace</title><meta name="description" content="Explore related legal authorities and review the sources behind an AI-generated research note."><script src="https://cdn.tailwindcss.com"></script><script>tailwind.config={corePlugins:{preflight:false}}</script><script defer src="https://unpkg.com/vis-network@9.1.9/standalone/umd/vis-network.min.js"></script><style>
:root{--canvas:#f6f5f2;--surface:#fff;--ink:#20252e;--muted:#636772;--brand:#4e4aa4;--brand-hover:#3a367f;--brand-soft:#eeedf9;--line:#dedfe4;--navy:#202137;--warm:#fbf5e8;--warm-ink:#73501b;--success:#32664e;--success-soft:#eff6f1;--radius:12px;--small-radius:6px;--shadow:0 3px 16px #20213706;--s1:4px;--s2:8px;--s3:12px;--s4:16px;--s5:24px;--s6:32px;--s7:48px;--s8:64px;--body:16px;--small:13px;--label:11px;--title:40px;--section:25px;--line-body:1.65;--line-heading:1.2;--width:1200px;--font:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;--serif:Georgia,"Times New Roman",serif}
*{box-sizing:border-box}body{margin:0;background:var(--canvas);color:var(--ink);font:var(--body)/var(--line-body) var(--font)}button,input,textarea{font:inherit}button,a{touch-action:manipulation}button{cursor:pointer}a{color:var(--brand);text-underline-offset:3px}button:focus-visible,a:focus-visible,summary:focus-visible,textarea:focus-visible{outline:3px solid var(--brand);outline-offset:4px}[hidden]{display:none!important}.skip{position:absolute;top:-100px;padding:var(--s3);background:var(--surface);z-index:9}.skip:focus{top:0}.preview{background:var(--brand-soft);color:var(--brand);font-size:var(--small);text-align:center;padding:var(--s2) var(--s4)}.preview strong{font-weight:650}.topbar{background:var(--surface);border-bottom:1px solid var(--line)}.top-inner{max-width:var(--width);margin:auto;padding:var(--s5) var(--s6);display:flex;align-items:center;gap:var(--s6)}.wordmark{display:flex;align-items:center;gap:var(--s3);font:600 26px/1 var(--serif);color:var(--navy);text-decoration:none}.mark{width:31px;height:31px;color:var(--brand);display:grid;place-items:center;border:1px solid var(--brand);border-radius:var(--small-radius);font-size:23px}.nav-label{font-size:var(--small);border-left:1px solid var(--line);padding-left:var(--s5);color:var(--muted)}.top-right{margin-left:auto;display:flex;align-items:center;gap:var(--s4);font-size:var(--small);color:var(--muted)}.dot{width:6px;height:6px;display:inline-block;background:var(--success);border-radius:50%;margin-right:var(--s2)}.help{background:transparent;border:1px solid var(--line);border-radius:50%;width:30px;height:30px;color:var(--muted)}main{max-width:var(--width);padding:var(--s7) var(--s6);margin:auto}.eyebrow{font-size:var(--label);letter-spacing:.12em;text-transform:uppercase;font-weight:700;color:var(--muted)}h1,h2,h3,p{margin:0}h1{font:var(--title)/var(--line-heading) var(--serif);letter-spacing:-.025em;margin:var(--s3) 0}h2{font:var(--section)/var(--line-heading) var(--serif);letter-spacing:-.015em}h3{font-size:var(--body);line-height:1.45}.intro{display:flex;align-items:end;justify-content:space-between;gap:var(--s5);margin-bottom:var(--s5)}.intro p{color:var(--muted);max-width:720px}.coverage{white-space:nowrap;font-size:var(--small);color:var(--muted);padding-bottom:var(--s1)}.search-box{border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);padding:var(--s5);box-shadow:var(--shadow)}.search-box label{display:block;font-size:var(--small);font-weight:650;margin-bottom:var(--s2)}.search-row{display:flex;align-items:center;gap:var(--s5)}textarea{resize:vertical;flex:1;min-width:0;width:100%;border:0;background:transparent;padding:var(--s2) 0;min-height:64px;color:var(--ink);font-size:18px;line-height:1.5}textarea:focus{outline:0}textarea:focus-visible{outline:2px solid var(--brand);outline-offset:4px;border-radius:var(--small-radius)}.primary{border:0;background:var(--brand);color:var(--surface);padding:var(--s3) var(--s5);border-radius:var(--small-radius);font-size:14px;font-weight:650;white-space:nowrap;min-height:46px}.primary:hover{background:var(--brand-hover)}.primary:disabled{opacity:.65;cursor:wait}.search-footer{display:flex;align-items:center;gap:var(--s3);border-top:1px solid var(--line);padding-top:var(--s4);margin-top:var(--s3);font-size:var(--small);color:var(--muted)}.topic{background:var(--canvas);border:1px solid transparent;color:var(--muted);border-radius:var(--small-radius);padding:var(--s1) var(--s3);min-height:34px;font-size:var(--small)}.topic:hover{background:var(--brand-soft);color:var(--brand)}.privacy{margin-left:auto;font-size:var(--label)}.workspace-heading{display:flex;justify-content:space-between;gap:var(--s4);align-items:center;margin:var(--s6) 0 var(--s4)}.result-label{font-weight:650;font-size:14px}.result-label span{font-weight:400;color:var(--muted);margin-left:var(--s3);font-size:var(--small)}.subtle-button{border:0;background:transparent;color:var(--muted);font-size:var(--small);min-height:32px;padding:var(--s1) var(--s2)}.workspace{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(320px,1fr);gap:var(--s5);align-items:start}.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}.summary{padding:var(--s6)}.panel-heading{display:flex;align-items:center;justify-content:space-between;gap:var(--s3);margin-bottom:var(--s5)}.kicker{display:flex;align-items:center;gap:var(--s2);font-size:var(--label);letter-spacing:.08em;text-transform:uppercase;color:var(--brand);font-weight:700;margin-bottom:var(--s3)}.note-icon{font-size:16px;line-height:1}.notice{background:var(--warm);border:1px solid #eadfc7;color:var(--warm-ink);padding:var(--s4);border-radius:var(--small-radius);font-size:var(--small);line-height:1.55;margin-bottom:var(--s5)}.notice strong{display:block;font-weight:700;margin-bottom:var(--s1)}.prose{line-height:1.8;max-width:68ch}.prose p+p{margin-top:var(--s4)}.prose h3{font-size:18px;margin:var(--s3) 0 var(--s4)}.cite-ref{display:inline-flex;align-items:center;justify-content:center;vertical-align:baseline;border:0;border-radius:var(--small-radius);background:var(--brand-soft);color:var(--brand);font:650 12px/1 var(--font);min-width:25px;min-height:25px;padding:var(--s1);margin:0 2px}.cite-ref:hover{background:var(--brand);color:white}.checks{margin-top:var(--s5);padding-top:var(--s5);border-top:1px solid var(--line);font-size:var(--small)}.checks-title{color:var(--success);font-weight:650;display:flex;align-items:center;gap:var(--s2)}.checks p{color:var(--muted);margin-top:var(--s2);line-height:1.55}.actions{display:flex;align-items:center;gap:var(--s4);margin-top:var(--s5)}.secondary-button{border:1px solid var(--line);background:var(--surface);color:var(--ink);font-size:var(--small);padding:var(--s2) var(--s3);min-height:40px;border-radius:var(--small-radius)}.secondary-button:hover{background:var(--canvas)}.muted{color:var(--muted)}.small{font-size:var(--small)}.sources-heading{padding:var(--s5);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:var(--s2)}.sources-heading h2{font:650 16px/1.4 var(--font)}.count{display:inline-flex;align-items:center;justify-content:center;border-radius:50%;background:var(--canvas);color:var(--muted);font-size:12px;width:24px;height:24px}.tabs{padding:0 var(--s5);display:flex;gap:var(--s5);border-bottom:1px solid var(--line)}.tab{border:0;background:transparent;color:var(--muted);padding:var(--s3) 0;min-height:45px;font-size:var(--small);border-bottom:2px solid transparent}.tab[aria-selected=true]{color:var(--brand);border-color:var(--brand);font-weight:650}.source-list{padding:0 var(--s5)}.source{display:block;width:100%;padding:var(--s4) 0;text-align:left;border:0;border-bottom:1px solid var(--line);background:transparent}.source:last-child{border-bottom:0}.source:hover .source-title{text-decoration:underline;text-underline-offset:3px}.source-title{font-weight:600;color:var(--ink);font-size:14px;line-height:1.45;display:flex;gap:var(--s3)}.ref-label{flex:0 0 24px;color:var(--brand);font-size:var(--small);font-weight:650}.source-meta{display:block;margin-left:36px;margin-top:var(--s1);font-size:12px;line-height:1.5;color:var(--muted)}.source[aria-pressed=true]{background:var(--brand-soft);margin:0 calc(-1 * var(--s3));padding-left:var(--s3);padding-right:var(--s3);width:calc(100% + 24px);border-radius:var(--small-radius)}.source-detail{padding:var(--s5);background:var(--canvas);border-top:1px solid var(--line);border-radius:0 0 var(--radius) var(--radius)}.source-detail h3{margin:var(--s2) 0 var(--s3)}.source-detail .actions{margin-top:var(--s4)}.source-detail a{font-size:var(--small);font-weight:650}.source-detail p{font-size:var(--small);color:var(--muted)}.map{padding:var(--s5)}.map-item{border:1px solid var(--line);padding:var(--s3);border-radius:var(--small-radius);font-size:var(--small)}.connector{color:var(--muted);text-align:center;font-size:var(--small);padding:var(--s2)}.activity{margin-top:var(--s5);border:1px solid var(--line);background:var(--surface);border-radius:var(--radius)}summary{cursor:pointer;min-height:56px;padding:var(--s4) var(--s5);font-size:var(--small);font-weight:600}summary span{font-weight:400;color:var(--muted);margin-left:var(--s3)}.activity-body{padding:0 var(--s5) var(--s5);font-size:var(--small)}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--s3);margin-bottom:var(--s4)}.step{border-top:2px solid var(--success);padding-top:var(--s2)}.step span{display:block;color:var(--muted);font-size:12px}.technical{font-family:ui-monospace,monospace;font-size:12px;color:var(--muted);overflow-wrap:anywhere}footer{display:flex;justify-content:space-between;gap:var(--s5);font-size:12px;color:var(--muted);padding:var(--s5) 0;margin-top:var(--s5);border-top:1px solid var(--line)}.footer-brand{white-space:nowrap}.status{font-size:var(--small);margin-top:var(--s3);color:var(--brand)}.limit-copy{max-width:75ch}dialog{max-width:540px;width:calc(100% - 32px);border:1px solid var(--line);border-radius:var(--radius);padding:var(--s6);color:var(--ink);background:var(--surface)}dialog::backdrop{background:#20213766}dialog p{margin:var(--s4) 0;color:var(--muted)}.empty{padding:var(--s7);text-align:center}.empty p{margin:var(--s3) 0;color:var(--muted)}
@media(max-width:900px){:root{--title:34px}.workspace{grid-template-columns:minmax(0,1.25fr) minmax(290px,1fr)}.summary{padding:var(--s5)}.coverage{display:none}.privacy{margin-left:0}.intro{display:block}.nav-label{display:none}}
@media(max-width:700px){:root{--title:31px;--section:24px}.top-inner{padding:var(--s4) var(--s5)}.top-right .service{display:none}main{padding:var(--s6) var(--s4)}.intro p{font-size:14px}.search-box{padding:var(--s4)}.search-row{display:block}textarea{font-size:16px;min-height:90px}.primary{width:100%;margin-top:var(--s2)}.search-footer{flex-wrap:wrap;gap:var(--s2)}.search-footer>span{width:100%}.workspace{grid-template-columns:1fr}.workspace-heading{margin-top:var(--s5)}.result-label span{display:none}.summary{padding:var(--s5)}.source-title{font-size:14px}.steps{grid-template-columns:repeat(2,1fr)}footer{display:block}footer .footer-brand{margin-top:var(--s3)}.actions{flex-wrap:wrap}.preview{font-size:11px}.activity summary span{display:block;margin-left:0}.prose{font-size:16px}}
@media(prefers-reduced-motion:no-preference){button,a{transition:background-color .12s,color .12s}}
aside.panel{display:flex;flex-direction:column}.sources-heading{order:1}.tabs{order:2}.source-detail{order:3;border-top:0;border-bottom:1px solid var(--line);border-radius:0}.source-list{padding-bottom:var(--s2)}#sources-pane,#trail-pane{order:4}

:root{--danger:#9c3030;--danger-soft:#fcf0f0;--notice-line:#eadfc7;--reading-line:1.8;--graph-height:370px;--viewer-height:500px}
.demo-links{display:flex;gap:var(--s4)}.demo-links a{text-decoration:none}.demo-links a:hover{text-decoration:underline}.glass{background:var(--navy);border:1px solid var(--muted)}.search-footer{flex-wrap:wrap}.privacy{width:100%;margin-left:0}.voice-dock{display:flex;align-items:center;gap:var(--s3);margin-top:var(--s4)}.voice-dock #vorb{position:relative;bottom:auto;right:auto;width:44px;height:44px;flex-shrink:0;box-shadow:none}.voice-dock #vwave{width:44px;height:44px}.voice-dock #vicon{font-size:20px}.voice-dock #vstate{position:static;width:auto;color:var(--muted);font-size:var(--label)}.voice-dock #vcap{background:var(--navy);max-width:calc(100% - 32px);right:16px;bottom:16px}.preview{display:none}.top-right{flex-wrap:wrap}main{padding-top:var(--s6)}.intro .coverage{white-space:normal;text-align:right;max-width:230px}
.prose{line-height:var(--reading-line)}.prose p,.prose ul,.prose ol,.prose blockquote{margin-bottom:var(--s4)}.prose p:last-child{margin-bottom:0}.prose ul,.prose ol{padding-left:var(--s5)}.prose li+li{margin-top:var(--s2)}.prose blockquote{border-left:3px solid var(--brand);padding:var(--s3) var(--s4);background:var(--brand-soft);color:var(--ink)}.prose code{background:var(--canvas);border-radius:var(--small-radius);padding:var(--s1);font-size:.9em}.prose h3{font-family:var(--serif);font-weight:400;font-size:var(--section)}
.notice{border-color:var(--notice-line)}.error-panel{margin:var(--s5) 0;border:1px solid var(--danger);background:var(--danger-soft);border-radius:var(--radius);padding:var(--s5);color:var(--danger)}.error-panel .secondary-button{margin-top:var(--s3)}.check-failed,.invalid-ref{color:var(--danger)}.offline-note{background:var(--danger-soft);color:var(--danger);border:1px solid var(--danger);padding:var(--s3);border-radius:var(--small-radius);font-size:var(--small);margin-bottom:var(--s4)}.coverage-note{background:var(--brand-soft);padding:var(--s4);border-radius:var(--small-radius);font-size:var(--small);margin-bottom:var(--s5)}
.progress{padding:var(--s5);border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);margin-bottom:var(--s5)}.progress p{color:var(--muted);font-size:var(--small);margin-top:var(--s2)}.results{scroll-margin-top:var(--s5)}.result-label span{font-size:var(--small)}.source-detail{border-radius:0;border-top:0;border-bottom:1px solid var(--line);order:initial}.sources-heading,.tabs,#sources-pane,#trail-pane{order:initial}.source-detail h3{scroll-margin-top:var(--s5)}.passage{white-space:pre-wrap;font-family:var(--serif);padding:var(--s4);background:var(--surface);border-left:3px solid var(--brand);font-size:var(--body);line-height:var(--line-body);margin:var(--s4) 0;max-height:360px;overflow:auto}.source-stats{margin-top:var(--s3);overflow-wrap:anywhere}.source-list{padding-bottom:var(--s2)}.source-title,.source-meta{overflow-wrap:anywhere}.graph-wrap{height:var(--graph-height);width:100%;margin-top:var(--s4)}.no-sources{padding:var(--s5);color:var(--muted);font-size:var(--small)}
.activity>summary{display:block}.activity>summary:before{content:'+';display:inline-block;margin-right:var(--s3);font-size:18px;color:var(--brand)}.activity[open]>summary:before{content:'−'}.activity-body{border-top:1px solid var(--line);padding-top:var(--s5)}.step{border-color:var(--line)}.step.on{border-color:var(--brand)}.step.done{border-color:var(--success)}.step strong{font-weight:600}.events{max-height:310px;overflow:auto;border:1px solid var(--line);border-radius:var(--small-radius);margin-top:var(--s4)}.event{padding:var(--s3);border-bottom:1px solid var(--line)}.event:last-child{border-bottom:0}.event p{margin:var(--s1) 0 0;overflow-wrap:anywhere}.secondary-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--s5);margin-top:var(--s5)}#case-view{grid-column:1/-1}.secondary-grid details{border:1px solid var(--line);border-radius:var(--small-radius);min-width:0}.secondary-content{padding:0 var(--s4) var(--s4)}.task-row{display:flex;gap:var(--s3);justify-content:space-between;padding:var(--s3) 0;border-bottom:1px solid var(--line);font-size:var(--small)}.task-row>span{overflow-wrap:anywhere}.task-row>span:last-child{flex:0 0 100px}.case-stage{height:var(--viewer-height);position:relative;background:var(--navy);border-radius:var(--small-radius);margin-top:var(--s4);overflow:hidden}#docs3d{position:absolute;inset:0}#docnav{display:flex;gap:var(--s2);flex-wrap:wrap;margin-top:var(--s3)}#docs3d canvas{display:block}.voice-options{display:flex;align-items:center;gap:var(--s2);font-size:var(--small)}.voice-options input{width:17px;height:17px;accent-color:var(--brand)}.source-detail .actions{margin-top:var(--s4)}.error-panel p,.notice{overflow-wrap:anywhere}.legend{display:flex;gap:var(--s4);font-size:var(--label);margin-top:var(--s3);color:var(--muted)}.legend i{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--brand);margin-right:var(--s1)}.legend span:last-child i{background:var(--muted)}.empty .eyebrow{margin-bottom:var(--s3)}.empty h2{max-width:25ch;margin:auto}.empty p{max-width:65ch;margin:var(--s3) auto}.empty{padding:var(--s7) var(--s5)}#copy:disabled{opacity:.6}#services{margin-top:var(--s3)}.help-close{display:flex;justify-content:end;margin-top:var(--s5)}
@media(max-width:700px){.top-inner{flex-wrap:wrap;gap:var(--s3)}.top-right{width:100%;justify-content:space-between}.secondary-grid{grid-template-columns:1fr}.task-row{display:block}.task-row span{display:block}.privacy{display:block;width:100%}.sources-heading{padding:var(--s5)}.intro .coverage{display:none}.empty{padding:var(--s6) var(--s5)}.case-stage{height:440px}.case-stage>.z-10{width:calc(100% - 32px)}.result-label{font-size:var(--small)}}
</style><script src="/static/vendor/d3-array.min.js"></script><script src="/static/vendor/d3-geo.min.js"></script></head><body>
<a class="skip" href="#q">Skip to research question</a>
<header class="topbar"><div class="top-inner"><a class="wordmark" href="/" aria-label="Precedent home"><span class="mark" aria-hidden="true">P</span>Precedent</a><span class="nav-label">Legal research workspace</span><div class="top-right"><nav aria-label="Demo pages" class="demo-links"><a href="/dashboard">Dashboards</a><a href="/slides">Slides</a></nav><button class="help" aria-label="About this research demo" id="help">?</button></div></div></header>
<main>
<section aria-labelledby="page-title"><div class="intro"><div><div class="eyebrow">From question to sources</div><h1 id="page-title">What are you researching?</h1><p>Find related authorities. Read the sources. Build your understanding.</p></div><div class="coverage">Check each source’s jurisdiction and date before relying on it.</div></div>
<form id="search" class="search-box"><label for="q">Your legal research question</label><div class="search-row"><textarea id="q" rows="2" maxlength="500" placeholder="For example: What counts as motor vehicle theft in Colorado?" aria-describedby="question-hint"></textarea><button class="primary" id="go" type="submit">Find sources ↗</button></div><div class="search-footer"><span>Try a topic</span><button type="button" class="topic" data-question="Can police search a car without a warrant if they have probable cause?">Vehicle searches</button><button type="button" class="topic" data-question="Can a landlord evict a tenant without a court order?">Tenant eviction</button><button type="button" class="topic" data-question="Water rights priority dispute between ranchers">Water rights</button><button type="button" class="topic" data-question="Is marijuana possession a crime after Amendment 64?">Marijuana possession</button><span id="question-hint" class="privacy">Avoid names and confidential case details. Shift + Enter adds a line.</span></div></form>
<div id="status" class="status" role="status" aria-live="polite"></div></section>
<section id="error" class="error-panel" role="alert" hidden><strong>Research could not finish</strong><p id="error-message"></p><button class="secondary-button" id="retry" hidden>Check this run again</button></section>
<div class="workspace-heading"><div class="result-label">Research workspace <span id="result-count"></span></div><button id="reset" class="subtle-button">New question ↗</button></div>
<section id="progress" class="progress" aria-label="Research progress" hidden><strong id="progress-text">Finding related authorities…</strong><p>You can follow the steps in Research activity below.</p></section>
<section id="empty" class="panel empty"><div class="eyebrow">A starting point for legal research</div><h2>Find the sources behind your question.</h2><p>Use a specific legal topic and include the jurisdiction when you know it. This demo searches a citation graph; some results may not include source text.</p><p class="small">A generated note is a starting point. Read the original authorities to verify it.</p></section>
<div id="results" class="workspace results" aria-busy="false" hidden>
<section class="panel summary" aria-labelledby="answer-title"><div class="kicker"><span class="note-icon" aria-hidden="true">✧</span> AI research note</div><div class="panel-heading"><h2 id="answer-title" tabindex="-1">Your research note</h2></div>
<div id="offline-note" class="offline-note" hidden><strong>Template response · live model unavailable.</strong> This response uses retrieved metadata and a fixed template.</div>
<div class="notice" id="source-limit"><strong>Source text is missing from this result</strong>This draft uses titles and citation relationships. It cannot establish what the law requires. Read the full sources before relying on it.</div><p id="source-coverage" class="coverage-note" hidden></p>
<div class="prose" id="answer"></div><div class="checks"><div id="sg" class="checks-title"></div><p id="check-detail"></p></div><div class="actions"><button class="secondary-button" id="copy">Copy research note</button><button class="secondary-button" id="play" hidden>Listen</button><label id="voice-options" class="voice-options" hidden><input type="checkbox" id="hf">Read new notes aloud</label><span class="small muted">AI-generated · Review required</span></div><p id="disc" class="small muted" style="margin-top:var(--s5)"></p></section>
<aside class="panel" aria-labelledby="sources-title"><div class="sources-heading"><h2 id="sources-title">Review the sources</h2><span class="count" id="source-count">0</span></div><div class="tabs" role="tablist" aria-label="Evidence view"><button class="tab" id="sources-tab" role="tab" aria-selected="true" aria-controls="sources-pane">Source list</button><button class="tab" id="trail-tab" role="tab" aria-selected="false" aria-controls="trail-pane" tabindex="-1">Citation trail</button></div>
<section class="source-detail" id="source-detail" aria-labelledby="selected-title" hidden><div class="eyebrow">Selected authority</div><h3 id="selected-title" tabindex="-1"></h3><p id="selected-meta"></p><blockquote class="passage" id="passage" hidden></blockquote><p id="missing-passage" style="margin-top:var(--s3)">No passage available. Check the source page for the full text and current version.</p><div class="actions"><a id="source-link" target="_blank" rel="noopener noreferrer">Open source page ↗</a><span id="no-link" class="small muted" hidden>No source link available</span></div><p id="source-stats" class="source-stats"></p></section>
<div id="sources-pane" role="tabpanel" aria-labelledby="sources-tab"><div id="no-sources" class="no-sources" hidden>No authorities were retrieved. Try a more specific legal topic.</div><div class="source-list" id="cites"></div></div>
<div id="trail-pane" class="map" role="tabpanel" aria-labelledby="trail-tab" hidden><p id="graph-message" class="small muted">Explore the citation relationships. Select a labeled source to inspect it. A relationship alone does not establish relevance.</p><div class="legend"><span><i></i>Retrieved source</span><span><i></i>Related authority</span></div><div id="net" class="graph-wrap" role="img" aria-label="Citation relationships. The same source identifiers and paths are available in the source list."></div></div></aside>
</div>
<details id="activity" class="activity" hidden><summary>Research activity <span id="activity-summary">Review the steps and service details</span></summary><div class="activity-body"><div class="steps" id="seats"></div><p class="technical" id="meta"></p><p class="technical" id="services"></p><div class="events" id="events" aria-label="Research event log"></div>
<div class="secondary-grid"><details id="case-view"><summary>Citation map &amp; case files</summary><div class="secondary-content"><p class="small muted" id="viewer-note">A visual index of the retrieved authorities. It is not a scanned original document.</p><button class="secondary-button" id="enable-viewer" hidden>Enable animated view</button><div class="case-stage"><div id="docs3d"></div></div><div id="docnav"></div></div></details><details id="team-view"><summary>Team task board</summary><div class="secondary-content"><p class="small muted">Coordination details for the demo team.</p><div id="tasks"></div></div></details></div></div></details>
<details class="activity"><summary>Live sponsor stack <span>Dashboard and service metrics</span></summary><div class="activity-body"><p class="small"><a href="/dashboard">Open dashboard ↗</a> · <a href="/slides">Open slides ↗</a></p><iframe title="Live sponsor stack" src="/dashboard?compact=1" loading="lazy" style="width:100%;height:760px;border:0;margin-top:var(--s4)"></iframe></div></details><footer><p class="limit-copy">For legal research, not legal advice. Verify the source text, jurisdiction, and current law. Do not enter confidential information.</p><p class="footer-brand">Precedent · Research demo</p></footer>
</main>
<dialog id="about"><h2>A starting point for research</h2><p>Precedent retrieves related authorities and produces an AI research note. Results may contain only titles and citation relationships, without the text of the law.</p><p>Reference checks confirm matches against retrieved sources. They do not verify legal accuracy, relevance, or whether a source is current.</p><p>Enter a question or select a topic, then choose Find sources. Inspect the sources before relying on the note.</p><form method="dialog" class="help-close"><button class="secondary-button">Close</button></form></dialog>
<script>/* Precedent presentation layer. API contracts and model/retrieval logic are unchanged. */
const $ = id => document.getElementById(id);
const SEATS = [['planner','Plan'],['retriever','Retrieve'],['answer','Draft'],['safeguard','Check references']];
let currentResult = null, activeRun = null, busy = false, tts = false, network = null;
let selectedRef = null, viewerPromise = null, audio = null, audioUrl = null, audioContext = null, lastAskTime = 0, finishAudio = null;
const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
const esc = value => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const safeURL = value => { try { const u = new URL(value); return ['http:','https:'].includes(u.protocol) ? u.href : null; } catch { return null; } };
const delay = ms => new Promise(resolve => setTimeout(resolve, ms));

async function api(url, options = {}) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 15000);
  try {
    const response = await fetch(url, {...options, signal: controller.signal});
    if (!response.ok) throw new Error(`Request failed (${response.status})`);
    return await response.json();
  } finally { clearTimeout(timer); }
}
function announce(message) { $('status').textContent = message; }
function setBusy(value) {
  busy = value;
  $('go').disabled = value;
  $('go').textContent = value ? 'Researching…' : 'Find sources ↗';
  $('q').disabled = value;
  document.querySelectorAll('[data-question]').forEach(button => button.disabled = value);
  $('reset').disabled = value;
  $('results').setAttribute('aria-busy', String(value));
}
function showError(message, retry = false) {
  $('error-message').textContent = message;
  $('error').hidden = false;
  $('retry').hidden = !retry;
  announce(message);
}
function seats(state = {}) {
  $('seats').replaceChildren();
  SEATS.forEach(([id, title], index) => {
    const card = document.createElement('div'); card.className = 'step ' + (state[id] || '');
    const heading = document.createElement('strong'); heading.textContent = `${index + 1}. ${title}`;
    const status = document.createElement('span');
    status.textContent = state[id] === 'on' ? 'Working' : state[id] === 'done' ? 'Complete' : 'Waiting';
    card.append(heading, status); $('seats').appendChild(card);
  });
}
function resetResult() {
  currentResult = null; activeRun = null; selectedRef = null;
  stopAudio();
  $('results').hidden = true; $('empty').hidden = false;
  $('error').hidden = true; $('progress').hidden = true;
  $('activity').hidden = true; $('play').hidden = true;
  $('answer').replaceChildren(); $('cites').replaceChildren(); $('events').replaceChildren();
  $('result-count').textContent = '';
  $('activity-summary').textContent = 'Review the steps and service details';
  $('meta').textContent = '';
  if (network) { network.destroy(); network = null; }
  window.Docs3D?.idle(); seats();
}
async function ask(event) {
  event?.preventDefault();
  if (busy || Date.now() - lastAskTime < 800) return null;
  const question = $('q').value.trim();
  if (!question) { announce('Enter a legal research question first.'); $('q').focus(); return; }
  if (question.length > 500) { announce('Keep the question to 500 characters or fewer.'); return; }
  lastAskTime = Date.now(); resetResult(); setBusy(true);
  $('empty').hidden = true; $('progress').hidden = false; $('activity').hidden = false;
  $('progress-text').textContent = 'Finding related authorities…';
  announce('Research started. You can follow progress below.');
  if ($('case-view').open) window.Docs3D?.busy();
  try {
    const data = await api('/api/ask', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({question})});
    if (!data.run_id) throw new Error('No research run was returned');
    activeRun = data.run_id;
    return await poll(activeRun);
  } catch (error) {
    if (!activeRun) {
      showError('The request could not be confirmed. It may have started; check Research activity before submitting it again.');
      setBusy(false); $('progress').hidden = true;
    }
  }
}
function showEvents(events) {
  const state = {};
  events.forEach(e => { if (e.kind === 'claim') state[e.agent] = 'on'; if (['release','handoff'].includes(e.kind)) state[e.agent] = 'done'; });
  seats(state);
  const current = SEATS.find(([id]) => state[id] === 'on');
  const messages = {planner:'Planning the research…', retriever:'Finding related authorities…', answer:'Drafting the research note…', safeguard:'Checking references against the sources…'};
  if (current) $('progress-text').textContent = messages[current[0]];
  $('events').replaceChildren();
  events.forEach(e => {
    const row = document.createElement('div'); row.className = 'event';
    const meta = document.createElement('span'); meta.className = 'technical'; meta.textContent = `${String(e.ts || '').slice(11,19)} · ${e.agent || ''} · ${e.kind || ''}`;
    const message = document.createElement('p'); message.textContent = String(e.msg || '') + (e.to ? ` → ${e.to}` : '');
    row.append(meta, message); $('events').appendChild(row);
  });
}
async function poll(run) {
  const deadline = Date.now() + 120000;
  try {
    while (activeRun === run && Date.now() < deadline) {
      const data = await api('/api/run/' + encodeURIComponent(run));
      showEvents(Array.isArray(data.events) ? data.events : []);
      if (data.result) {
        render(data.result); setBusy(false); $('progress').hidden = true;
        announce('Research complete. Review the draft and its sources.');
        $('answer-title').focus({preventScroll:true});
        $('results').scrollIntoView({behavior: reducedMotion.matches ? 'auto' : 'smooth', block:'start'});
        return data.result;
      }
      await delay(700);
    }
    showError('This research run is taking longer than expected. Check the same run again without submitting another question.', true);
  } catch {
    showError('We lost the connection while checking the result. Check this run again; your question will not be resubmitted.', true);
  }
  setBusy(false); $('progress').hidden = true; window.Docs3D?.idle();
}
function inline(text, refs) {
  let value = esc(text).replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>').replace(/(^|[^*])\*([^*\n]+)\*/g,'$1<em>$2</em>').replace(/`([^`]+)`/g,'<code>$1</code>');
  return value.replace(/\[(\d+)\]/g, (match, n) => refs.has(match)
    ? `<button class="cite-ref" data-ref="${match}" aria-label="Review source ${n}: ${esc(refs.get(match).title)}">${n}</button>`
    : `<span class="invalid-ref" title="Reference not found in retrieved sources">${match}</span>`);
}
function markdown(source, refs) {
  const lines = String(source || '').replace(/\r/g,'').replace(/\\n/g,'\n').split('\n');
  let html = '', paragraph = [], list = null, quote = [];
  const flushParagraph = () => { if (paragraph.length) { html += `<p>${inline(paragraph.join(' '),refs)}</p>`; paragraph=[]; } };
  const flushList = () => { if (list) { html += `</${list}>`; list=null; } };
  const flushQuote = () => { if (quote.length) { html += `<blockquote>${inline(quote.join(' '),refs)}</blockquote>`; quote=[]; } };
  for (const raw of lines) {
    const line = raw.trim(); let match;
    if (!line) { flushParagraph(); flushList(); flushQuote(); continue; }
    if ((match=line.match(/^#{1,4}\s+(.*)/))) { flushParagraph();flushList();flushQuote();html+=`<h3>${inline(match[1],refs)}</h3>`;continue; }
    if ((match=line.match(/^>\s?(.*)/))) { flushParagraph();flushList();quote.push(match[1]);continue; }
    if ((match=line.match(/^(?:[-*•]|\d+[.)])\s+(.*)/))) {
      flushParagraph();flushQuote();const tag=/^\d/.test(line)?'ol':'ul';
      if(list!==tag){flushList();html+=`<${tag}>`;list=tag;}
      html+=`<li>${inline(match[1],refs)}</li>`;continue;
    }
    flushList();flushQuote();paragraph.push(line);
  }
  flushParagraph();flushList();flushQuote();return html;
}
function render(result) {
  currentResult = result;
  const citations = Array.isArray(result.citations) ? result.citations : [];
  const refs = new Map(citations.map(c => [c.ref,c]));
  $('results').hidden = false; $('empty').hidden = true; $('error').hidden = true;
  $('answer-title').textContent = 'Your research note';
  $('answer').innerHTML = markdown(result.answer, refs);
  $('answer').querySelectorAll('[data-ref]').forEach(button => button.onclick = () => selectSource(button.dataset.ref, true));
  const hasPassages = citations.some(c => typeof c.passage === 'string' && c.passage.trim());
  $('source-limit').hidden = hasPassages;
  $('source-coverage').hidden = !hasPassages;
  if (hasPassages) $('source-coverage').textContent = 'Source excerpts are available for some results. Open each source to verify its full context and current version.';
  const offline = /template|fake|offline/i.test(result.provider || '');
  $('offline-note').hidden = !offline;
  const safeguard = result.safeguard || {};
  const used = Array.isArray(safeguard.used) ? safeguard.used : [];
  const invalidCount = (safeguard.invalid || []).length + (safeguard.unknown_authorities || []).length;
  $('sg').textContent = safeguard.pass ? `${used.length} references matched the retrieved sources` : `Reference check needs review${invalidCount ? ` · ${invalidCount} unmatched` : ''}`;
  $('sg').className = 'checks-title ' + (safeguard.pass ? '' : 'check-failed');
  const uncited = (safeguard.unsupported_claims || []).length;
  $('check-detail').textContent = 'This checks reference matches, not legal accuracy or whether the law is current.' + (uncited ? ` ${uncited} sentence(s) without citations were flagged.` : '');
  $('disc').textContent = safeguard.disclaimer || 'This is an AI-generated research summary, not legal advice. Verify all authorities and consult a licensed attorney.';
  $('meta').textContent = `Run ${result.run_id || ''} · Model: ${result.provider || 'unavailable'} · Source passages: ${result.passage_source || 'none (graph only)'} · ${result.backend || ''} · ${result.elapsed_s ?? '?'}s`;
  $('result-count').textContent = `${citations.length} authorities found · ${result.elapsed_s ?? '?'} seconds`;
  $('source-count').textContent = citations.length;
  $('activity-summary').textContent = `Completed · ${result.elapsed_s ?? '?'} seconds`;
  $('cites').replaceChildren();
  citations.forEach(c => {
    const button = document.createElement('button'); button.className='source'; button.dataset.ref=c.ref;button.setAttribute('aria-pressed','false');
    const title=document.createElement('span');title.className='source-title';
    const ref=document.createElement('span');ref.className='ref-label';ref.textContent=c.ref;
    const name=document.createElement('span');name.textContent=c.title || c.id;
    title.append(ref,name);
    const meta=document.createElement('span');meta.className='source-meta';meta.textContent=[c.id,c.court,c.date || 'Date unavailable'].filter(Boolean).join(' · ');
    button.append(title,meta);button.onclick=()=>selectSource(c.ref);$('cites').appendChild(button);
  });
  $('no-sources').hidden = citations.length > 0;
  $('source-detail').hidden = !citations.length;
  if (citations.length) selectSource(used.find(ref=>refs.has(ref)) || citations[0].ref);
  if (network) {network.destroy();network=null;}
  if ($('trail-tab').getAttribute('aria-selected') === 'true') renderNetwork();
  $('docnav').replaceChildren();
  citations.slice(0,12).forEach((c,index)=>{const b=document.createElement('button');b.className='secondary-button';b.textContent=c.ref;b.setAttribute('aria-label','Show case file '+(c.title||c.id));b.onclick=()=>{window.Docs3D?.focus(index);window.Docs3D?.open?.(c);};$('docnav').appendChild(b);});
  if ($('case-view').open) loadViewer();
  $('play').hidden=!tts;
  if (tts && $('hf').checked && (!window.PrecedentVoice || window.PrecedentVoice.state() === 'idle')) playAnswer();
}
function selectSource(ref, focus = false) {
  const c = currentResult?.citations.find(c=>c.ref===ref);if(!c)return;
  selectedRef=ref;activateTab('sources');
  $('source-detail').hidden=false;
  $('selected-title').textContent=c.title || c.id;
  $('selected-meta').textContent=[c.id,c.court,c.date || 'Date unavailable'].filter(Boolean).join(' · ');
  const link=safeURL(c.url);$('source-link').hidden=!link;$('no-link').hidden=!!link;if(link)$('source-link').href=link;
  $('passage').hidden=!c.passage;$('missing-passage').hidden=!!c.passage;$('passage').textContent=c.passage || '';
  $('source-stats').textContent=`${c.cited_by ?? 0} citing references · Citation path: ${(c.path || []).join(' → ')}`;
  document.querySelectorAll('.source').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.ref===ref)));
  const index=currentResult.citations.indexOf(c);if($('case-view').open)window.Docs3D?.focus(index);
  if(focus){$('selected-title').focus({preventScroll:true});$('source-detail').scrollIntoView({behavior:reducedMotion.matches?'auto':'smooth',block:'nearest'});}
}
function activateTab(name) {
  ['sources','trail'].forEach(n=>{const selected=n===name;$(n+'-tab').setAttribute('aria-selected',String(selected));$(n+'-tab').tabIndex=selected?0:-1;$(n+'-pane').hidden=!selected;});
  $('source-detail').hidden=name!=='sources' || !currentResult?.citations?.length;
  if(name==='trail')requestAnimationFrame(renderNetwork);
}
function renderNetwork() {
  if(!currentResult)return;
  if(!window.vis){$('graph-message').textContent='The graph could not load. The source list and citation paths are still available.';return;}
  if(network){network.redraw();network.fit();return;}
  const r=currentResult,ids=new Set(),refOf={};
  (r.citations||[]).forEach(c=>{ids.add(c.id);refOf[c.id]=c.ref;});(r.seeds||[]).forEach(id=>ids.add(id));(r.edges||[]).forEach(e=>{ids.add(e.src);ids.add(e.dst);});
  const styles=getComputedStyle(document.documentElement),brand=styles.getPropertyValue('--brand').trim(),muted=styles.getPropertyValue('--muted').trim(),ink=styles.getPropertyValue('--ink').trim();
  const nodes=[...ids].map(id=>({id,label:(refOf[id]?refOf[id]+' ':'')+(id.length>28?id.slice(0,26)+'…':id),shape:'dot',size:refOf[id]?15:8,color:refOf[id]?brand:muted,font:{color:ink,size:11},title:id}));
  network=new vis.Network($('net'),{nodes,edges:(r.edges||[]).map(e=>({from:e.src,to:e.dst,arrows:'to',color:{color:muted}}))},{physics:reducedMotion.matches?false:{stabilization:true},interaction:{hover:true},layout:{randomSeed:3}});
  network.on('selectNode',event=>{const c=r.citations.find(c=>c.id===event.nodes[0]);if(c)selectSource(c.ref,true);});
}
async function loadViewer(force = false) {
  if(reducedMotion.matches && !force){$('viewer-note').textContent='Animated case files are off because reduced motion is enabled. All sources remain available in the source list.';$('enable-viewer').hidden=false;return;}
  $('enable-viewer').hidden=true;
  try {
    viewerPromise ||= import('/static/map3d.js');await viewerPromise;
    $('viewer-note').textContent='A visual index of the retrieved authorities. It is not a scanned original document.';
    if(currentResult)window.Docs3D?.show(currentResult.citations,currentResult.edges||[],currentResult.documents||[]);else if(busy)window.Docs3D?.busy();
  }catch{viewerPromise=null;$('viewer-note').textContent='The animated viewer could not load. Use the source list to inspect the same authorities.';}
}
function stopAudio(){if(audio){audio.pause();audio=null;}if(audioUrl){URL.revokeObjectURL(audioUrl);audioUrl=null;}if(finishAudio){finishAudio();finishAudio=null;}window.__ttsLevel=0;window.Docs3D?.pulse(0);$('play').textContent='Listen';$('play').disabled=false;}
function shortLine(answer){const lines=String(answer||'').split('\n').map(s=>s.trim()).filter(Boolean);let text=lines.find(s=>/short answer/i.test(s))||lines[0]||'';text=text.replace(/\*\*?short answer:?\*\*?:?/i,'').replace(/\[\d+\]/g,'').replace(/[*#>`_]/g,'').replace(/\s+/g,' ').trim();return text.length>300?text.slice(0,300).replace(/\s\S*$/,'')+'.':text;}
async function playAnswer(){
  if(!tts||!currentResult)return;if(audio&&!audio.paused){stopAudio();return;}
  $('play').disabled=true;$('play').textContent='Preparing audio…';
  try{
    const response=await fetch('/api/tts',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:shortLine(currentResult.answer)})});
    if(!response.ok){
      if('speechSynthesis' in window){announce('Provider audio is unavailable. Using your browser voice.');await new Promise(resolve=>{const utterance=new SpeechSynthesisUtterance(shortLine(currentResult.answer));utterance.onend=resolve;utterance.onerror=resolve;speechSynthesis.speak(utterance);});return;}
      throw new Error();
    }
    stopAudio();audioUrl=URL.createObjectURL(await response.blob());const a=new Audio(audioUrl);audio=a;
    try{audioContext ||= new(window.AudioContext||window.webkitAudioContext)();await audioContext.resume();const source=audioContext.createMediaElementSource(a),analyser=audioContext.createAnalyser();analyser.fftSize=256;source.connect(analyser);analyser.connect(audioContext.destination);const bytes=new Uint8Array(analyser.frequencyBinCount);const tick=()=>{if(a.paused||a.ended)return;analyser.getByteFrequencyData(bytes);window.Docs3D?.pulse(bytes.reduce((s,x)=>s+x,0)/bytes.length/255);requestAnimationFrame(tick);};a.onplay=tick;}catch{}
    a.ontimeupdate=()=>{const count=Math.min(currentResult?.citations.length||0,5);if(a.duration&&count&&$('case-view').open)window.Docs3D?.focus(Math.min(count-1,Math.floor(a.currentTime/a.duration*count)));};
    a.onended=stopAudio;a.onerror=()=>{stopAudio();announce('Audio could not play. The research note remains available to read.');};
    await a.play();$('play').textContent='Stop audio';$('play').disabled=false;
    await new Promise(resolve=>{finishAudio=resolve;if(a.ended)stopAudio();});
  }catch{stopAudio();announce('Audio is unavailable right now. You can still read the research note.');}
  finally{$('play').disabled=false;}
}
async function board(){try{const d=await api('/api/tasks');$('tasks').replaceChildren();Object.entries(d.tasks||{}).forEach(([id,t])=>{const row=document.createElement('div');row.className='task-row';const text=document.createElement('span');text.textContent=`${id} · ${t.priority} · ${t.title}`;const state=document.createElement('span');state.className='small muted';state.textContent=t.status+(t.owner?' · '+t.owner:'');row.append(text,state);$('tasks').appendChild(row);});}catch{$('tasks').textContent='Team activity is unavailable. Research remains available.';}}
async function health(){try{const h=await api('/api/health');tts=!!h.elevenlabs;$('voice-options').hidden=!tts;if(currentResult)$('play').hidden=!tts;if(tts){const script=document.createElement('script');script.src='/static/voice.js';script.onload=()=>{const button=$('vorb');if(button){button.type='button';button.setAttribute('aria-label','Start or stop voice research');button.parentElement.classList.add('voice-dock');$('search').appendChild(button.parentElement);}};document.body.appendChild(script);}$('services').textContent=`Daytona ${h.sandbox?'connected':'unavailable'} · Database: ${h.backend} · Claude ${h.anthropic?'configured':'not configured'} · Arize ${h.arize?'on':'off'} · Voice ${h.elevenlabs?'on':'off'}`;}catch{$('services').textContent='Service status unavailable.';}}
$('search').onsubmit=ask;
$('q').onkeydown=e=>{if(e.key==='Enter'&&!e.shiftKey&&!e.isComposing){e.preventDefault();ask();}};
$('reset').onclick=()=>{if(busy)return;resetResult();$('q').value='';announce('Ready for a new research question.');$('q').focus();};
document.querySelectorAll('[data-question]').forEach(b=>b.onclick=()=>{$('q').value=b.dataset.question;$('q').focus();announce('Topic selected. Choose Find sources to start research.');});
$('retry').onclick=async()=>{if(!activeRun||busy)return;$('error').hidden=true;setBusy(true);$('progress').hidden=false;await poll(activeRun);};
['sources','trail'].forEach((name,index)=>{$(name+'-tab').onclick=()=>activateTab(name);$(name+'-tab').onkeydown=e=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(e.key)){e.preventDefault();const next=e.key==='Home'?'sources':e.key==='End'?'trail':['trail','sources'][index];activateTab(next);$(next+'-tab').focus();}};});
$('copy').onclick=async()=>{if(!currentResult)return;const prefix=currentResult.citations.some(c=>c.passage)?'AI research note — verify sources and current law.':'UNVERIFIED AI research note — source text unavailable.';try{await navigator.clipboard.writeText(prefix+'\n\n'+currentResult.answer+'\n\n'+$('disc').textContent);announce('Research note copied with its source limitation and disclaimer.');}catch{announce('Copy was unavailable. Select the note to copy it manually.');}};
$('help').onclick=()=>$('about').showModal();
$('play').onclick=playAnswer;
$('case-view').ontoggle=()=>{if($('case-view').open)loadViewer();else window.Docs3D?.idle();};
$('enable-viewer').onclick=()=>loadViewer(true);
$('team-view').ontoggle=()=>{if($('team-view').open)board();};
setInterval(()=>{if($('team-view').open)board();},5000);
window.PRECEDENT={ask:async text=>{if(busy)return null;$('q').value=text;return await ask();},speak:playAnswer};
seats();health();
</script></body></html>